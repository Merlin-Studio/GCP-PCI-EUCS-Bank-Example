# --- Binary Authorization in app-dev-0 -------------------------------
# A project has one policy. Every application stage in this project used to
# write its own, each replacing the last; the policy is created here instead,
# once, and every application's Cloud Run services are evaluated against it.
#
# ARCHITECT TODO: the attestor trusts a key that is yours. Create it and add
# its public key to the attestor; until then the policy is in dry run and
# records what it would have refused rather than refusing it. When your
# pipeline signs every image, set enforcement_mode to ENFORCED_BLOCK_AND_AUDIT_LOG.
resource "google_binary_authorization_policy" "project_app_dev_0" {
  project = local.project_app_dev_0

  default_admission_rule {
    evaluation_mode  = "REQUIRE_ATTESTATION"
    enforcement_mode = "DRYRUN_AUDIT_LOG_ONLY"
    require_attestations_by = [
      google_binary_authorization_attestor.project_app_dev_0.name,
    ]
  }

  # Google's own images are not signed by you and still have to run.
  admission_whitelist_patterns {
    name_pattern = "gcr.io/google-containers/*"
  }
  admission_whitelist_patterns {
    name_pattern = "us-docker.pkg.dev/cloudrun/container/*"
  }
}

